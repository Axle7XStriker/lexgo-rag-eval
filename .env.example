# Copy to .env and fill in real values.
# Startup validates the required keys before Streamlit boots — missing key = clear error, not a silent fallback.

# ─── Required ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# ─── Optional overrides (defaults live in src/lexgo/config.py) ────────────
# Postgres+pgvector — matches the docker-compose service; override for a remote DB.
DATABASE_URL=postgresql://lexgo:lexgo@localhost:5432/lexgo

# Model IDs — override here if the SDK rejects the defaults.
# CHAT_MODEL=claude-sonnet-4-6
# JUDGE_MODEL=claude-sonnet-4-6
# EMBEDDING_MODEL=voyage-3-large
# Rerank model is per-pipeline; configured in src/pipeline/pipeline_config.py,
# not here.

# LOG_LEVEL=INFO
